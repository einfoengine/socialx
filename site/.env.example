# Marketing site environment
#
# Copy to .env.local and fill in.
#
# Note what is absent, because it is the point of this file being short: there is
# no database URL, no service role key, and no Stripe secret key. This site is a
# consumer of the portal's API, not a co-owner of its database. It reads content
# and pricing over /api/v1 with a scoped key, and everything about money happens
# on the portal side.

# ---------------------------------------------------------------------------
# How this site reaches the portal
# ---------------------------------------------------------------------------
# Origin of the portal application.
PORTAL_API_URL=http://localhost:3001

# A key minted in the portal at /admin/sites. It names its own site exactly, so
# it reaches this site's content and nothing else. Server side only: it is never
# shipped to the browser.
PORTAL_API_KEY=

# Names the site for the unauthenticated read path, which reaches only entries
# somebody deliberately marked public. Ignored when PORTAL_API_KEY is set.
PORTAL_SITE_KEY=

# ---------------------------------------------------------------------------
# Public addresses
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001

# Publishable, not secret. This one is meant to be in the browser bundle; the
# secret key lives in the portal and never comes here.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Image host for next/image, when media is served from HighLevel.
NEXT_PUBLIC_HL_CDN_HOST=
