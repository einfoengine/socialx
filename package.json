{
  "name": "social-x",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:site": "pnpm --filter @socialx/site dev",
    "dev:console": "pnpm --filter @socialx/console dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "build:site": "pnpm --filter @socialx/site build",
    "build:console": "pnpm --filter @socialx/console build",
    "lint": "pnpm --filter \"./apps/*\" lint",
    "typecheck": "pnpm --filter \"./apps/*\" exec tsc --noEmit",
    "secure-env": "node scripts/secure-env.mjs",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:seed": "node scripts/db.mjs seed",
    "db:test": "node scripts/db.mjs test",
    "db:all": "node scripts/db.mjs all",
    "db:status": "node scripts/db.mjs status",
    "stripe:sync": "node scripts/stripe-sync.mjs",
    "stripe:dry": "node scripts/stripe-sync.mjs --dry",
    "test:checkout": "node scripts/test-checkout.mjs",
    "test:webhook": "node scripts/test-webhook.mjs",
    "test:batch": "node scripts/test-batch.mjs",
    "media:sync": "node scripts/sync-media.mjs",
    "media:verify": "node scripts/sync-media.mjs --verify",
    "test:approvals": "node scripts/test-approvals.mjs",
    "test:links": "node scripts/test-links.mjs",
    "test:embedded": "node scripts/test-embedded.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "seed:demo:remove": "node scripts/seed-demo.mjs --remove",
    "test:site-content": "node scripts/test-site-content.mjs",
    "test:api": "node scripts/test-api.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "stripe": "^22.5.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.0"
}
