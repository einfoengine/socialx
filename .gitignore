# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Per-project build output
portal/.next/
site/.next/
portal/tsconfig.tsbuildinfo
site/tsconfig.tsbuildinfo

# Runtime configuration written by /setup. Holds the database password.
portal/config/portal.json

# .env.example files are documentation and ARE committed; the .env* rule above
# would otherwise swallow them.
!portal/.env.example
!site/.env.example
