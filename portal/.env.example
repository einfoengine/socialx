# Portal environment
#
# Copy to .env.local and fill in. Nothing here is read at build time by the new
# data layer: DATABASE_URL is resolved at runtime through lib/core/config.ts, so
# a deployment that would rather use the /setup screen can leave it blank.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Any PostgreSQL 13 or later. Supabase, DigitalOcean, RDS, Neon, or a container
# on the same host: all of them are a connection string, and there is nothing
# else to choose.
#
# TWO connections, and this is the part most installs get wrong.
#
# The application must NOT be a superuser or a table owner. Postgres exempts
# both from every row level security policy, silently, which means one wrong
# connection string turns off tenant isolation with no error anywhere. The
# migrations must create tables, which portal_app deliberately cannot.
#
# On a first install portal_app does not exist yet, because migration 0031
# creates it. So: point both at an owner connection, migrate, give portal_app a
# password, then narrow DATABASE_URL and restart.
#
#   alter role portal_app with login password 'choose-one';

# What the application serves on. portal_app. No DDL, no RLS exemption.
DATABASE_URL=postgres://portal_app:PASSWORD@HOST:5432/DBNAME

# What migrations run on. An owner or admin role. Falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=

# verify (default) | no-verify | disable
#
# verify is correct and is what you want. If it fails with a certificate error,
# the right fix is DATABASE_CA_CERT below, not no-verify: no-verify encrypts and
# then trusts whoever answered, which stops eavesdropping but not an active
# attacker. Most providers publish a CA bundle.
DATABASE_SSL=verify

# The provider's CA certificate, inline as PEM. Use this instead of no-verify.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Connections per instance. Multiply by your instance count and keep it under
# the plan's connection limit.
DATABASE_POOL_MAX=10

# A statement running longer than this is cancelled by the server, so one
# runaway query cannot hold a pooled connection until every request is queued
# behind it.
DATABASE_STATEMENT_TIMEOUT_MS=15000

# A transaction idle longer than this is ended by the server, so a request that
# died mid-transaction cannot hold its locks indefinitely.
DATABASE_IDLE_TX_TIMEOUT_MS=30000

# Every variable here also accepts a <NAME>_FILE variant pointing at a file, for
# Docker secrets and Kubernetes:
#   DATABASE_URL_FILE=/run/secrets/database_url

# ---------------------------------------------------------------------------
# Supabase (legacy, still required)
# ---------------------------------------------------------------------------
# The 320 queries that have not moved to lib/core/db yet still go through
# PostgREST, and auth is still GoTrue. These stay needed until that migration
# finishes. On a non-Supabase database the portal will not fully work yet.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used by scripts/db.mjs when DATABASE_URL is not set.
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# HighLevel media
# ---------------------------------------------------------------------------
HL_API_KEY=
HL_MEDIA_LOCATION_ID=
NEXT_PUBLIC_HL_CDN_HOST=

# ---------------------------------------------------------------------------
# Addresses and scheduled work
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001

# Shared secret for /api/internal/webhooks/drain and the billing import. Unset
# means those endpoints refuse everything, which is safe but stops webhook
# retries from ever running.
CRON_SECRET=
